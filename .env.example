# Шаблон переменных окружения KB Search Agent. Скопируйте в .env и заполните нужное.
# .env в .gitignore; реальные ключи и пароли в этот шаблон не записываются.
# Переменные окружения перекрывают значения из config/agent.yaml.

# ---------------------------------------------------------------------------
# Сервис и агент (src/serve.py, src/agent_cli.py). Все переменные необязательны:
# значения по умолчанию — в config/agent.yaml. Ключ API не нужен — модель локальная (Ollama).
# ---------------------------------------------------------------------------
# AGENT_PROFILE=public                # public — 5 PDF и синтетический реестр; full — рабочая база (только внутренний контур)
# AGENT_LLM_BACKEND=ollama            # ollama | mock (mock — без модели, для проверки оркестрации)
# AGENT_LLM_BASE_URL=http://localhost:11434   # в Docker: http://ollama:11434
# AGENT_LLM_MODEL=qwen2.5:7b-instruct
# AGENT_RETRIEVER=qdrant              # qdrant | lexical (lexical — поиск BM25 без модели эмбеддингов)
# RAG_EMBEDDINGS_ALLOW_DOWNLOAD=1     # 0 — модель эмбеддингов только из локального кэша, без обращений к Hugging Face
# ESCALATION_QUEUE_PATH=data/escalations/escalations.jsonl   # очередь обращений к ответственным (в .gitignore)
# LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=json                     # json — одна строка JSON на событие; text — для чтения глазами.
#                                     # Текст вопросов и ответов в журнал не пишется ни в одном формате.

# ---------------------------------------------------------------------------
# RAG-пайплайн с YandexGPT (src/rag_answer.py, src/llm_client.py) — отдельный этап проекта,
# сервис и агент эти переменные НЕ читают.
# ---------------------------------------------------------------------------
# Идентификатор каталога Yandex Cloud, вида b1g******************
YC_FOLDER_ID=
# Ключ сервисного аккаунта с ролью ai.languageModels.user (заголовок Authorization: Api-Key …)
YC_API_KEY=
# Альтернатива ключу: IAM-токен (Authorization: Bearer …), живёт 12 часов
YC_IAM_TOKEN=
# OpenAI-совместимый клиент
LLM_API_KEY=
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_MODEL=yandexgpt-5-lite/latest
# LLM_AUTH_SCHEME=Api-Key             # Api-Key | Bearer

# ---------------------------------------------------------------------------
# Служебные
# ---------------------------------------------------------------------------
# RAG_FAKE_EMBEDDINGS=1               # эмбеддинги-заглушка без torch: проверка сборки индекса и оркестрации, не качества
# HF_HUB_DISABLE_TELEMETRY=1          # код ставит сам; телеметрия библиотек Hugging Face отключена
# HF_HUB_OFFLINE=1                    # переменная huggingface_hub: полностью запретить сетевые обращения
