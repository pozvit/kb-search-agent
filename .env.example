# Идентификатор каталога Yandex Cloud, вида b1g******************
YC_FOLDER_ID=

# API-ключ сервисного аккаунта с ролью ai.languageModels.user.
LLM_API_KEY=

# OpenAI-совместимый эндпоинт Yandex Cloud
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Модель
LLM_MODEL=yandexgpt-5-lite/latest

# ---------------------------------------------------------------------------
# MVP-агент (src/agent_cli.py). Все переменные необязательны: значения по умолчанию
# заданы в config/agent.yaml. Ключ API не нужен — используется локальная Ollama.
# Переменные LLM_* выше агент НЕ читает (они для YandexGPT в rag_answer.py).
# ---------------------------------------------------------------------------
# AGENT_LLM_BACKEND=ollama          # ollama | mock
# AGENT_LLM_BASE_URL=http://localhost:11434
# AGENT_LLM_MODEL=qwen2.5:7b-instruct
# AGENT_RETRIEVER=qdrant            # qdrant | lexical
# AGENT_PROFILE=public              # public | full
